{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Valeurs du chart plateforme",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "profile": { "type": "string", "enum": ["app", "static"] },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repository": { "type": "string" },
        "tag": { "type": ["string", "number"] },
        "pullPolicy": { "type": "string", "enum": ["IfNotPresent", "Always", "Never"] }
      }
    },
    "imagePullSecrets": { "type": "array", "items": { "type": "string" } },
    "host": { "type": "string" },
    "tls": { "type": "boolean" },
    "port": { "type": ["integer", "null"], "minimum": 1, "maximum": 65535 },
    "healthPath": { "type": ["string", "null"] },
    "args": { "type": "array", "items": { "type": "string" } },
    "replicas": { "type": "integer", "minimum": 0 },
    "shutdownDelaySeconds": { "type": "integer", "minimum": 0, "maximum": 25 },
    "env": { "type": "object", "additionalProperties": { "type": ["string", "number", "boolean"] } },
    "secretEnv": { "type": "array", "items": { "type": "string" } },
    "persistence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "size": { "type": "string" },
        "mountPath": { "type": "string" },
        "storageClass": { "type": "string" }
      }
    },
    "resources": { "type": "object" },
    "podSecurityContext": { "type": "object" }
  }
}
